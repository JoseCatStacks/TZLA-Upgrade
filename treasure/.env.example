APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Solana / Helius ─────────────────────────────────────────────────────────
# 'stub' accepts ANY fee signature and reports fake holdings. It is refused
# outside of local/testing, so production MUST be set to 'helius'.
SOLANA_PROVIDER=stub
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Required when SOLANA_PROVIDER=helius.
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com

# Commitment used to verify fee payments. 'finalized' is stricter but adds ~13s.
SOLANA_COMMITMENT=confirmed

# Required for holdings checks; if blank, no wallet will ever qualify via TZLA.
SOLANA_TZLA_MINT=
SOLANA_NFT_COLLECTION=
SOLANA_HOLDINGS_CACHE_TTL=300
SOLANA_NONCE_TTL=300

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# REQUIRED for the webhook. Generate with: php artisan tinker --execute="echo Str::random(48);"
# Register the same value with Telegram:
#   curl -F "url=https://YOURDOMAIN/api/telegram/webhook" \
#        -F "secret_token=THIS_VALUE" \
#        https://api.telegram.org/bot<TOKEN>/setWebhook
# The webhook rejects every request while this is blank.
TELEGRAM_WEBHOOK_SECRET=

# ─── Game rules ──────────────────────────────────────────────────────────────
GAME_TZLA_THRESHOLD=9.63

# Per-guess fee in SOL, by holder tier. These are the keys the app actually
# reads (the old GAME_SUBMISSION_FEES_SOL was never wired to anything).
GAME_FEE_GOLDEN_TICKET_SOL=0.0639
GAME_FEE_STANDARD_SOL=0.09
GAME_FEE_TOLERANCE_LAMPORTS=1000

# How recent a payment must be to count, in seconds.
GAME_FEE_MAX_AGE_SECONDS=3600

# REQUIRED. Wallet that receives all guess fees. There is no default; guesses
# are refused while this is blank rather than paying an unknown address.
GAME_TREASURY_ADDRESS=

# Attempts per word: base, plus one per NFT held, capped at the maximum.
GAME_ATTEMPTS_BASE=1
GAME_ATTEMPTS_MAX=5

# Must stay >= GAME_ATTEMPTS_MAX or holders cannot spend the attempts they earn.
GAME_SPAM_MAX_PER_MINUTE=10

GAME_WINNERS_LOG_CHANNEL=winners

